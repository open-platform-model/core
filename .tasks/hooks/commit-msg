#!/usr/bin/env bash
# core/ commit-msg hook — refuse a bare @mention or forbidden AI attribution
# in a commit message.
#
# Source of truth: core/.tasks/hooks/commit-msg (installed by `task hooks:install`,
# which symlinks .git/hooks/commit-msg to this file).
#
# GitHub turns a bare `@name` into a USER MENTION. `@v0`, `@v1` and `@v2` are all
# real GitHub accounts, so writing `@v1` to mean "major version 1" subscribes an
# uninvolved stranger to the thread and leaves a permanent backlink on their
# profile. A commit message cannot be edited after it is pushed, and it also
# propagates: release-please replays commit bodies verbatim into the release PR
# and the GitHub Release, so one bad message leaks into generated notes months
# later. That is why this gate is at commit time rather than at review time.
#
# What is safe, measured against GitHub's renderer:
#   opmodel.dev/core@v2   safe  — `@` glued to a word character
#   `@v2`                 NOT safe here — commit messages are not Markdown, so
#                         backticks are literal and the mention still fires
#   "@v2" / '@v2' / \@v2  NOT safe — quoting and escaping do NOT suppress it
#
# So in a commit message: glue the `@` to its path, or drop it entirely
# ("the v2 line", "major v2").
#
# Bypass, for the rare case where a real mention is intended:
#   AT_MENTION_OK=1 git commit ...
#
# Full rule: CLAUDE.md § "Never Write a Bare `@name` Into GitHub Text"
#
# Attribution (no bypass): the only AI attribution allowed is the exact plain
# trailer `Co-Authored-By: Claude <noreply@anthropic.com>`. Session IDs/URLs,
# generated-with footers, and model-versioned AI co-author lines are refused.
# Full rule: CLAUDE.md § "Commit and PR Attribution — Plain Co-Author Line Only"

set -euo pipefail

msg_file="${1:?commit-msg hook requires the message file path}"

# Strip git's own comment lines and the scissors section before scanning —
# `# On branch ...` and the verbose diff are not part of the message.
body=$(sed -e '/^#/d' -e '/^diff --git /,$d' "$msg_file")

# A mention fires when `@` is NOT preceded by a word character. Anything else —
# start of line, whitespace, quote, backtick, paren, `>` — is a boundary GitHub
# accepts, which is why quoting does not help.
hits=$(printf '%s\n' "$body" | grep -nE '(^|[^A-Za-z0-9])@[A-Za-z0-9]' || true)
if [[ "${AT_MENTION_OK:-}" == "1" ]]; then
  hits=""
fi

# --- AI attribution (no bypass) ------------------------------------------
# Allowed, exactly: Co-Authored-By: Claude <noreply@anthropic.com>
ai='claude|anthropic|copilot|openai|chatgpt|gemini|codex|aider|devin|cursor|windsurf'

session=$(printf '%s\n' "$body" | grep -inE 'claude-session[[:space:]]*:|claude\.ai/code/session' || true)

generated=$(printf '%s\n' "$body" | grep -inE 'generated[[:space:]]+with' | grep -iE "${ai}|🤖" || true)

coauthor=$(printf '%s\n' "$body" | grep -inE '^[[:space:]]*co-authored-by:' \
  | grep -iE "$ai" \
  | grep -ivF 'co-authored-by: claude <noreply@anthropic.com>' || true)

if [[ -z "$hits" && -z "$session" && -z "$generated" && -z "$coauthor" ]]; then
  exit 0
fi

{
  echo "ERROR: commit message violates the mention/attribution rules."
  echo
  if [[ -n "$hits" ]]; then
    echo "Bare @mention — GitHub links each of these to a real user account, and a"
    echo "pushed commit message can never be edited:"
    printf '%s\n' "$hits" | sed 's/^/  /'
    echo
    echo "  • Glue the @ to its path      opmodel.dev/core@v2      (safe)"
    echo "  • Drop the @ entirely         \"the v2 line\", \"major v2\""
    echo "  • NOT quoting or backticks    \"@v2\", '@v2', \`@v2\`     (still mentions)"
    echo "  • Real mention intended?      AT_MENTION_OK=1 git commit ..."
    echo "  Rule: CLAUDE.md § \"Never Write a Bare \`@name\` Into GitHub Text\""
    echo
  fi
  if [[ -n "$session" ]]; then
    echo "Session identifier — never allowed, no bypass:"
    printf '%s\n' "$session" | sed 's/^/  /'
    echo
  fi
  if [[ -n "$generated" ]]; then
    echo "AI generated-with footer — never allowed, no bypass:"
    printf '%s\n' "$generated" | sed 's/^/  /'
    echo
  fi
  if [[ -n "$coauthor" ]]; then
    echo "AI co-author trailer in a non-plain form. The only allowed AI attribution is"
    echo "exactly:  Co-Authored-By: Claude <noreply@anthropic.com>"
    printf '%s\n' "$coauthor" | sed 's/^/  /'
    echo
  fi
  echo "Rule: CLAUDE.md § \"Commit and PR Attribution — Plain Co-Author Line Only\""
} >&2
exit 1
